# Qwen3.8-27B on Intel Arc Pro B70 — vLLM 0.29.1 nightly recipe (WSL2/Docker Desktop)
#
# Why a separate file from Dockerfile: this generation needs two WSL-specific
# workarounds as ENV (see below) and runs with NO runtime patches -- upstream
# already contains the mamba align-cache fixes our 0.28.0 image had to vendor
# (#53945 / #54713 / #55450), and applying the 0.28-era patches on top of it
# makes the engine wedge. Keeping the recipes separate means a rollback to
# `snapshot-0.28.0-apc-broken` or `0.28.0-apcfix` still gets its own validated
# defaults instead of inheriting these.
#
# Build:
#   docker build -t zrlu/qwen38-27b-arc-pro-b70:0.29.1-nightly docker -f docker/Dockerfile.nightly
#
# Requires the 2026-09-16+ Intel Windows driver (32.0.101.9030). On the older
# driver the MTP path hangs on any prefill > ~130 tokens.

ARG BASE_IMAGE=vllm/vllm-openai-xpu:nightly
FROM ${BASE_IMAGE}

# Create stub files to prevent NVIDIA library lookups on WSL2/Arc systems
RUN mkdir -p /usr/lib/wsl/lib && \
    touch /usr/lib/wsl/lib/libnvidia-ml.so.1 && \
    touch /usr/lib/wsl/lib/libcuda.so.1

COPY opt-qwen38/ /opt/qwen38/

# For the watchdog: dump a Python stack of a wedged EngineCore (needs the
# container to run with --cap-add SYS_PTRACE, which the launcher does).
RUN pip install --no-cache-dir py-spy && /opt/venv/bin/py-spy --version

# ---- Intel GPU user-mode driver upgrade ----------------------------------
# The base image ships compute-runtime 26.27.39122.11 + IGC 2.38.2. The
# EngineCore wedge on this stack traces to `urEventWait` spinning inside
# libze_intel_gpu.so.1.15.39122 (26.27) while the GPU sits idle -- a Level Zero
# UMD bug, not a vLLM one, and only a process restart clears it.
# 26.35.39758.10 (2026-09-17) is current, and it requires IGC >= 2.41.5, so both
# are upgraded together. libigdgmm12 is deliberately not reinstalled: the image
# already has 22.10.1, which satisfies the dependency.
ARG UMD_VERSION=26.35.39758.10
ARG IGC_VERSION=2.41.5+22716
RUN cd /tmp && \
    for u in \
      "https://github.com/intel/compute-runtime/releases/download/${UMD_VERSION}/libze-intel-gpu1_${UMD_VERSION}-0_amd64.deb" \
      "https://github.com/intel/compute-runtime/releases/download/${UMD_VERSION}/intel-opencl-icd_${UMD_VERSION}-0_amd64.deb" \
      "https://github.com/intel/compute-runtime/releases/download/${UMD_VERSION}/intel-ocloc_${UMD_VERSION}-0_amd64.deb" \
      "https://github.com/intel/intel-graphics-compiler/releases/download/v2.41.5/intel-igc-core-2_${IGC_VERSION}_amd64.deb" \
      "https://github.com/intel/intel-graphics-compiler/releases/download/v2.41.5/intel-igc-opencl-2_${IGC_VERSION}_amd64.deb" ; do \
      wget -q "$u" || exit 1; \
    done && \
    apt-get update -qq && apt-get install -y --no-install-recommends ./*.deb && \
    rm -f ./*.deb && rm -rf /var/lib/apt/lists/* && \
    dpkg -l | grep -E "libze-intel-gpu1|intel-opencl-icd|intel-ocloc|intel-igc" | awk '{print $2, $3}' && \
    ls -l /usr/lib/x86_64-linux-gnu/libze_intel_gpu.so.1.*

ENV CUDA_VISIBLE_DEVICES="" VLLM_ALLOW_RUNTIME_PLUGIN_REGISTER=1

# --- WSL2 workarounds (required, not tuning knobs) ------------------------
# 1. Library search order. The default puts /usr/lib/wsl/lib first, which is
#    needed for libcuda/libdxcore/libwsl_compute_helper, but it also shadows the
#    container's own IGC (/usr/local/lib, 2.38.2) with the Windows driver's
#    libigdfcl.so.2. That ABI mismatch makes oneDNN's GPTQ W4A16 GEMM report
#    CL_COMPILER_NOT_AVAILABLE -> "could not create a primitive" on any prefill
#    >= ~64 tokens. Putting the container's own libs first fixes it.
# 2. ONEAPI_DEVICE_SELECTOR hides the SYCL OpenCL backend so oneDNN cannot
#    prefer an OCL engine that cannot compile on WSL.
ENV LD_LIBRARY_PATH=/usr/local/lib:/opt/venv/lib:/usr/lib/wsl/lib:/opt/ucx/lib:/tmp/ucx_install/lib
ENV ONEAPI_DEVICE_SELECTOR=level_zero:*

# V1 model runner, not the default V2: the V2 GDN attention-metadata path
# (mamba_hybrid.py prepare_attn -> gdn_attn.py build) intermittently hangs in
# `urEventWait` with the GPU idle -- 3 of 4 runs of a 7-distinct-prompt sequence
# wedged on V2, 21/21 requests passed on V1. V1 also needs the #53919
# accepted-token race fix, hence PATCH_SET=minimal below.
ENV VLLM_USE_V2_MODEL_RUNNER=0

# The still-missing correctness patches: vllm#53505 (backward mamba state copy)
# and vllm#53919 (accepted-token race, V1-only). The 0.28-era patches in the
# `full` set are NOT applied -- they conflict with upstream's own fixes.
ENV B70_PATCH_SET=minimal

# WSL2/Arc production defaults (the launcher passes these explicitly too).
ENV VLLM_TARGET_DEVICE=xpu \
    VLLM_TRITON_USE_TD=1 \
    ZE_FLAT_DEVICE_HIERARCHY=COMPOSITE \
    ZE_AFFINITY_MASK=0 \
    VLLM_XPU_ENABLE_XPU_GRAPH=1 \
    VLLM_USE_BREAKABLE_CUDAGRAPH=1 \
    PYTORCH_ALLOC_CONF=expandable_segments:True \
    CCL_ATL_TRANSPORT=ofi \
    CCL_ENABLE_SYCL_KERNELS=0 \
    MTP_TOKENS=3 \
    DRAFT_INT4=0 \
    MAX_NUM_SEQS=1 \
    MAX_MODEL_LEN=200000 \
    KV_CACHE_MEMORY_BYTES=8053063680 \
    KV_CACHE_DTYPE=fp8 \
    GPU_MEMORY_UTILIZATION=0.88 \
    MAX_NUM_BATCHED_TOKENS=8192 \
    PREFIX_CACHE=1 \
    ENFORCE_EAGER=0 \
    MM_IMAGES=16 \
    TOOL_CALL_PARSER=qwen3_xml \
    MODEL_BOOTSTRAP=1 \
    HF_REPO=zrlu/Huihui-Qwen3.8-27B-abliterated-GPTQ-Int4-sym-G128-MTP-BF16-B70

EXPOSE 8000
LABEL version="0.29.1-nightly"
ENTRYPOINT ["bash", "/opt/qwen38/start.sh"]
